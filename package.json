{
  "name": "flextyres",
  "version": "1.0.0",
  "description": "FlexTyres — wholesale used car and truck tyres. Static Astro site.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/generate-redirects.mjs && node scripts/generate-headers.mjs",
    "build:bare": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "typecheck": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,css,json,md}\"",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "audit": "npm run typecheck && npm run build && npm run check:seo && npm run check:links && npm run check:a11y && npm run check:schema && npm run check:budget",
    "prepare:images": "node scripts/prepare-images.mjs",
    "prepare:brand": "node scripts/make-brand-assets.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "qa:serve": "node scripts/serve.mjs",
    "qa:shoot": "node scripts/shoot.mjs _research/shots",
    "audit:full": "npm run audit && npm run check:links:external && npm run check:mobile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mistermanuel94-netizen/z-tires.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/mistermanuel94-netizen/z-tires/issues"
  },
  "homepage": "https://github.com/mistermanuel94-netizen/z-tires#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
