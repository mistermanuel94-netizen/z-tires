{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "**/*.mjs"],
  "exclude": ["dist", "node_modules", "_research"],
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
