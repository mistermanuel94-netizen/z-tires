---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/blocks/PageHeader.astro';
import AnswerBlock from '~/components/blocks/AnswerBlock.astro';
import CTABand from '~/components/blocks/CTABand.astro';
import RelatedLinks from '~/components/blocks/RelatedLinks.astro';
import { graph, webPage, breadcrumbList, type Crumb } from '~/lib/schema';
import { canonical } from '~/lib/seo';
import { recyclingProducts } from '~/data/tyres';

import chipsImg from '~/assets/images/tyre-chips-pile.jpg';
import shredImg from '~/assets/images/tyre-shred-material.jpg';
import balesImg from '~/assets/images/baled-tyres-stacked.jpg';

const path = '/tyre-recycling/';
const url = canonical(path);
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Tyre recycling', path },
];

const schema = graph(
  webPage({
    url,
    name: 'Tyre recycling — chips and bales',
    description:
      'FlexTyres supplies recycled tyre material as chips in two grades and as bales, for tyres past reuse.',
    breadcrumbId: `${url}#breadcrumb`,
  }),
  breadcrumbList(url, crumbs),
);
---

<BaseLayout
  title="Tyre Recycling — Chips & Bales"
  description="FlexTyres supplies tyres past reuse as recycled material: tyre chips in high and low grades, and compressed bales. Request a quote by container."
  path={path}
  schema={schema}
  crumbs={crumbs}
>
  <PageHeader
    eyebrow="Recycling"
    title="Tyre recycling — chips and bales"
    lede="Not every used tyre has a second life on a vehicle. Those that do not are processed rather than discarded."
  />

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <AnswerBlock>
            <p>
              FlexTyres publishes recycled tyre material in three forms:
              <strong>high quality tyre chips</strong>, <strong>low quality tyre chips</strong> and
              <strong>bales</strong>. In the company's words: "At Flextyres we offer our tyres in
              chips and bales."
            </p>
          </AnswerBlock>

          <h2>Who this is for</h2>
          <p>
            Buyers processing tyre-derived material — rubber recyclers, tyre-derived fuel users,
            civil-engineering fill applications and retreaders sourcing casings. As with whole
            tyres, FlexTyres sells to trade buyers.
          </p>

          <h2>Why FlexTyres does it</h2>
          <p>
            The company frames it as part of the same commitment as its whole-tyre business: "We
            reduce environmental harm by giving tyres a second life." A tyre that cannot be resold
            still has material value.
          </p>
        </div>
        <figure>
          <Image
            src={chipsImg}
            alt="A large pile of shredded tyre chips at the recycling yard"
            widths={[400, 640, 800]}
            quality={68}
            sizes="(min-width: 56em) 40vw, 100vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--subtle" aria-labelledby="products-heading">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h2 id="products-heading">What FlexTyres supplies</h2>
      <ul class="grid grid--3 rec-grid">
        <li>
          <article class="card">
            <div class="card__media">
              <Image
                src={shredImg}
                alt="Close view of shredded tyre chip material showing exposed steel wire"
                widths={[320, 520, 700]}
                quality={70}
                sizes="(min-width: 60em) 30vw, (min-width: 40em) 45vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title">{recyclingProducts[0].name}</h3>
              <p class="card__text">{recyclingProducts[0].description}</p>
            </div>
          </article>
        </li>
        <li>
          <article class="card">
            <div class="card__media">
              <Image
                src={chipsImg}
                alt="A heap of lower-grade tyre chips ready for loading"
                widths={[320, 520, 700]}
                quality={70}
                sizes="(min-width: 60em) 30vw, (min-width: 40em) 45vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title">{recyclingProducts[1].name}</h3>
              <p class="card__text">{recyclingProducts[1].description}</p>
            </div>
          </article>
        </li>
        <li>
          <article class="card">
            <div class="card__media">
              <Image
                src={balesImg}
                alt="Compressed bales of whole tyres bound and stacked outdoors"
                widths={[320, 520, 700]}
                quality={70}
                sizes="(min-width: 60em) 30vw, (min-width: 40em) 45vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title">{recyclingProducts[2].name}</h3>
              <p class="card__text">{recyclingProducts[2].description}</p>
            </div>
          </article>
        </li>
      </ul>

      <div class="note">
        <svg
          class="note__icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-2h2zm0-4h-2V7h2z"></path>
        </svg>
        <div>
          <p>
            FlexTyres does not publish chip sizes, contamination limits, steel content, calorific
            values, minimum quantities or pricing for recycled material. Ask for those
            specifications when you request a quote — this page does not guess at them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="order-heading">
    <div class="container container--narrow">
      <span class="eyebrow">Ordering</span>
      <h2 id="order-heading">How to order recycled material</h2>
      <p>
        There is no separate form. Use the <a href="/contact/">contact form</a> or the
        <a href="/request-a-quote/">quote form</a> and describe what you need: the form (chips or bales),
        the grade, the volume, and the destination. Tell FlexTyres what the material is being used for
        — chip specification depends heavily on the application.
      </p>
      <p>
        Recycled material still ships under the same
        <a href="/legal/purchasing-terms/">purchasing terms</a> and the same
        <a href="/services/export-and-customs/">export and customs process</a> as whole tyres. Cross-border
        movement of tyre-derived material is regulated as waste in many jurisdictions — confirm the rules
        for your destination before ordering.
      </p>

      <RelatedLinks
        links={[
          {
            label: 'Export and customs',
            href: '/services/export-and-customs/',
            hint: 'Documentation and clearance',
          },
          {
            label: 'Used truck tyres',
            href: '/tyres/truck-tyres/',
            hint: 'Low-grade casings for retread',
          },
          { label: 'About FlexTyres', href: '/about/', hint: 'The company behind the operation' },
          { label: 'Contact', href: '/contact/', hint: 'Ask about specifications' },
        ]}
      />
    </div>
  </section>

  <CTABand
    heading="Ask about recycled tyre material"
    text="Tell FlexTyres the form, volume and destination you need and it will confirm what is available."
  />
</BaseLayout>

<style>
  .rec-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rec-grid li {
    margin: 0;
    max-width: none;
  }
</style>
