---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/blocks/PageHeader.astro';
import LegalNotice from '~/components/blocks/LegalNotice.astro';
import { graph, webPage, breadcrumbList, type Crumb } from '~/lib/schema';
import { canonical } from '~/lib/seo';
import { legalDocs } from '~/data/legal';

const path = '/legal/terms-and-conditions/';
const url = canonical(path);
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Legal', path: '/legal/' },
  { name: 'Terms and conditions', path },
];

/**
 * Website terms of use, version 2.0.
 *
 * The 2020 original was plugin boilerplate. Its substance is preserved — intellectual property,
 * third-party links, termination, disclaimer, governing law — with three corrections: the site
 * described is now this one, the trade-only nature of the business is stated, and the relationship
 * to the separate purchasing terms is made explicit, since the 2020 version left buyers unclear
 * which document governed a sale.
 */
const doc = legalDocs.websiteTerms;

const schema = graph(
  webPage({
    url,
    name: 'Website terms and conditions',
    description: 'The terms governing use of the FlexTyres website.',
    breadcrumbId: `${url}#breadcrumb`,
    datePublished: doc.effectiveDate,
  }),
  breadcrumbList(url, crumbs),
);
---

<BaseLayout
  title="Website Terms & Conditions"
  description="The terms governing use of the FlexTyres website, covering intellectual property, third-party links, termination, disclaimer and governing law."
  path={path}
  schema={schema}
  crumbs={crumbs}
>
  <PageHeader eyebrow="Legal" title="Terms and conditions" />

  <section class="section">
    <div class="container container--narrow prose">
      <LegalNotice
        reviewed={doc.legallyReviewed}
        version={doc.version}
        effectiveDate={doc.effectiveDate}
        supersedes={doc.supersedes}
      />

      <div class="note">
        <svg
          class="note__icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-2h2zm0-4h-2V7h2z"></path>
        </svg>
        <div>
          <p>
            These are the terms of use for <strong>this website</strong>. The terms that govern a
            <strong>purchase</strong> are the separate
            <a href="/legal/purchasing-terms/">purchasing terms and conditions</a>, and those
            prevail over this document in any conflict about a sale.
          </p>
        </div>
      </div>

      <p>
        Please read these Terms of Use ("Terms", "Terms of Use") carefully before using the
        flextyres.com website (the "Service") operated by Flextyres | Used &amp; New Tyres Export
        ("us", "we", or "our").
      </p>
      <p>
        Your access to and use of the Service is conditioned on your acceptance of and compliance
        with these Terms. These Terms apply to all visitors, users and others who access or use the
        Service.
      </p>
      <p>
        By accessing or using the Service you agree to be bound by these Terms. If you disagree with
        any part of the terms then you may not access the Service.
      </p>

      <h2>Intellectual property</h2>
      <p>
        The Service and its original content, features and functionality are and will remain the
        exclusive property of Flextyres | Used &amp; New Tyres Export and its licensors.
      </p>

      <h2>Links to other web sites</h2>
      <p>
        Our Service may contain links to third-party web sites or services that are not owned or
        controlled by Flextyres | Used &amp; New Tyres Export.
      </p>
      <p>
        Flextyres | Used &amp; New Tyres Export has no control over, and assumes no responsibility
        for, the content, privacy policies, or practices of any third party web sites or services.
        You further acknowledge and agree that Flextyres | Used &amp; New Tyres Export shall not be
        responsible or liable, directly or indirectly, for any damage or loss caused or alleged to
        be caused by or in connection with use of or reliance on any such content, goods or services
        available on or through any such web sites or services.
      </p>
      <p>
        We strongly advise you to read the terms and conditions and privacy policies of any
        third-party web sites or services that you visit.
      </p>

      <h2>Termination</h2>
      <p>
        We may terminate or suspend access to our Service immediately, without prior notice or
        liability, for any reason whatsoever, including without limitation if you breach the Terms.
      </p>
      <p>
        All provisions of the Terms which by their nature should survive termination shall survive
        termination, including, without limitation, ownership provisions, warranty disclaimers,
        indemnity and limitations of liability.
      </p>

      <h2>Disclaimer</h2>
      <p>
        Your use of the Service is at your sole risk. The Service is provided on an "AS IS" and "AS
        AVAILABLE" basis. The Service is provided without warranties of any kind, whether express or
        implied, including, but not limited to, implied warranties of merchantability, fitness for a
        particular purpose, non-infringement or course of performance.
      </p>

      <h2>Governing law</h2>
      <p>
        These Terms shall be governed and construed in accordance with the laws of Belgium without
        regard to its conflict of law provisions.
      </p>
      <p>
        Our failure to enforce any right or provision of these Terms will not be considered a waiver
        of those rights. If any provision of these Terms is held to be invalid or unenforceable by a
        court, the remaining provisions of these Terms will remain in effect. These Terms constitute
        the entire agreement between us regarding our Service, and supersede and replace any prior
        agreements we might have between us regarding the Service.
      </p>

      <h2>Changes</h2>
      <p>
        We reserve the right, at our sole discretion, to modify or replace these Terms at any time.
        If a revision is material we will try to provide at least 30 days notice prior to any new
        terms taking effect. What constitutes a material change will be determined at our sole
        discretion.
      </p>
      <p>
        By continuing to access or use our Service after those revisions become effective, you agree
        to be bound by the revised terms. If you do not agree to the new terms, please stop using
        the Service.
      </p>

      <h2>Trade use</h2>
      <p>
        This website is published for trade buyers. FlexTyres sells used tyres in commercial
        quantities and does not sell to consumers. Nothing on the site is an offer capable of
        acceptance; quotations and order confirmations are governed by the
        <a href="/legal/purchasing-terms/">purchasing terms</a>.
      </p>

      <h2>Accuracy of published information</h2>
      <p>
        FlexTyres takes care to keep the information on this site accurate, but tyre grades, sizes
        and stock are described as published and are subject to confirmation when you request a
        quote. Availability is not guaranteed by anything shown here.
      </p>

      <h2>What changed in this version</h2>
      <p>
        Version 2.0 replaces a version dated 1 October 2020. The substance is unchanged. The
        corrections are: the Service is now identified as this website rather than a URL that no
        longer exists; the trade-only nature of the business is stated; the relationship to the
        separate purchasing terms is made explicit, because the previous version left buyers unclear
        which document governed a sale; and a clause on the accuracy of published product
        information has been added.
      </p>

      <h2>Contact us</h2>
      <p>
        If you have any questions about these Terms, please <a href="/contact/">contact us</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .meta {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }
</style>
