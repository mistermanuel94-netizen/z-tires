---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/blocks/PageHeader.astro';
import AnswerBlock from '~/components/blocks/AnswerBlock.astro';
import { graph, webPage, breadcrumbList, type Crumb } from '~/lib/schema';
import { canonical } from '~/lib/seo';
import { documents, contact } from '~/data/site';

const path = '/legal/purchasing-terms/';
const url = canonical(path);
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Legal', path: '/legal/' },
  { name: 'Purchasing terms', path },
];

/**
 * This page summarises only the unambiguous commercial terms from the published PDF, and links to
 * the PDF itself as the authoritative document. It deliberately does not restate the document's
 * unfilled template placeholder, its blank dispute-resolution selection, or its 3%-per-day
 * interest clause — see CONTENT_TRUST_CONFLICTS.md C-19.
 */
const terms = [
  {
    term: 'Payment',
    detail: 'Net thirty (30) days from the invoice date, unless otherwise specified by the seller.',
  },
  {
    term: 'Disputed invoices',
    detail:
      'Notify the seller in writing within 3 days of receipt, detailing the reason, and pay all undisputed amounts.',
  },
  {
    term: 'Inspection window',
    detail:
      'A rejection for nonconformity is effective only if written notice reaches the seller within 3 days of receipt of the goods. After 3 days the goods are deemed to have had no defect.',
  },
  {
    term: 'Returns',
    detail:
      'Only with the seller’s written consent. All returns are assessed a 10% restocking fee. No returns of special, custom or made-to-order goods.',
  },
  {
    term: 'Refund cap',
    detail: 'The seller has a refund policy of up to fifty (50) tyres, at sales price.',
  },
  {
    term: 'Replacement of defects',
    detail:
      'Where a defect is reported within the notification window, the seller ships non-defective replacement goods at its own expense in exchange for the returned goods.',
  },
  {
    term: 'Cancellation',
    detail:
      'Only with the seller’s prior written consent, and subject to reasonable cancellation charges.',
  },
  {
    term: 'Delivery dates',
    detail:
      'Quoted dates are the seller’s best estimate and are subject to confirmation on acceptance of the order. The seller may make early or partial shipments and invoice accordingly.',
  },
  {
    term: 'Title and risk',
    detail:
      'Pass to the buyer when the goods are delivered to the destination port named in the accepted purchase order.',
  },
  {
    term: 'Shipping, taxes and duties',
    detail:
      'Not included in quoted prices unless expressly stated in writing. The buyer pays them directly or reimburses the seller.',
  },
  {
    term: 'Changes in freight cost',
    detail:
      'Any change in insurance premiums, destination or shipping charges established after order acceptance is at the buyer’s expense.',
  },
  {
    term: 'Failure to take delivery',
    detail:
      'Goods are held at the buyer’s risk and expense, and a fee of 10% of the value of the goods is charged.',
  },
  {
    term: 'Seller’s lien',
    detail:
      'The seller holds a lien and a security interest over the goods until the contract price is paid in full.',
  },
  {
    term: 'Warranty',
    detail:
      'Goods not manufactured by the seller carry only the manufacturer’s warranty, if any. The seller disclaims all other warranties, express or implied.',
  },
  {
    term: 'Regulatory compliance',
    detail:
      'The buyer must comply with the laws of their own country. The seller does not warrant that the goods conform to the laws of any destination.',
  },
  {
    term: 'Termination',
    detail: 'Either party may terminate on not less than 7 days’ written notice.',
  },
  {
    term: 'Governing law',
    detail:
      'Belgium. Where the buyer is outside the seller’s country, the UN Convention on Contracts for the International Sale of Goods applies.',
  },
];

const schema = graph(
  webPage({
    url,
    name: 'FlexTyres purchasing terms and conditions',
    description:
      'Key commercial terms for buying from FlexTyres: payment, inspection window, returns, title and risk, and governing law.',
    breadcrumbId: `${url}#breadcrumb`,
    datePublished: documents.purchasingTerms.lastUpdated,
  }),
  breadcrumbList(url, crumbs),
);
---

<BaseLayout
  title="Purchasing Terms & Conditions"
  description="Key commercial terms for buying used tyres from FlexTyres: net-30 payment, a three-day inspection window, a 10% restocking fee and Belgian governing law."
  path={path}
  schema={schema}
  crumbs={crumbs}
>
  <PageHeader
    eyebrow="Legal"
    title="Purchasing terms and conditions"
    lede="The terms that apply when you buy from FlexTyres. This page summarises them; the PDF is the authoritative document."
  />

  <section class="section">
    <div class="container container--narrow">
      <AnswerBlock>
        <p>
          Payment is <strong>net 30 days</strong> from invoice. You have
          <strong>three days from receipt</strong> to notify a defect in writing — after that the goods
          are deemed to have had no defect. Returns need written consent and carry a
          <strong>10% restocking fee</strong>, with refunds capped at
          <strong>fifty tyres</strong>. Title and risk pass at the
          <strong>destination port</strong>. The contract is governed by
          <strong>Belgian law</strong>.
        </p>
      </AnswerBlock>

      <p>
        <a class="btn btn--primary" href={documents.purchasingTerms.href} download>
          Download the full purchasing terms ({documents.purchasingTerms.type},
          {' '}{documents.purchasingTerms.sizeLabel})
        </a>
      </p>

      <div class="note">
        <svg
          class="note__icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-2h2zm0-4h-2V7h2z"></path>
        </svg>
        <div>
          <p>
            <strong>The published document is dated 1 October 2012.</strong> It has not been reissued
            since. Ask FlexTyres to confirm the current version applies to your order before you sign
            anything, and take your own legal advice on a cross-border purchase of this size.
          </p>
          <p>
            The summary below covers only the terms that are unambiguous in the published document.
            Some clauses in the PDF are incomplete or unclear. Where the summary and the PDF differ,
            the PDF governs.
          </p>
        </div>
      </div>

      <h2>Summary of key terms</h2>
      <div class="table-scroll">
        <table>
          <caption>Key commercial terms, from the published purchasing terms document</caption>
          <thead>
            <tr>
              <th scope="col">Term</th>
              <th scope="col">What the document says</th>
            </tr>
          </thead>
          <tbody>
            {
              terms.map((t) => (
                <tr>
                  <th scope="row">{t.term}</th>
                  <td>{t.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>What is not covered here</h2>
      <p>
        The published document also addresses limitation of liability, indemnification,
        confidentiality, force majeure, default, assignment, dispute resolution and general
        provisions. Those clauses are not summarised on this page because they need to be read in
        full. <a href={documents.purchasingTerms.href} download>Download the document</a>.
      </p>

      <h2>Questions about the terms</h2>
      <p>
        Contact FlexTyres before ordering: <a href={`tel:${contact.phoneE164}`}
          >{contact.phoneDisplay}</a
        >,
        <a href={contact.whatsappUrl} rel="noopener">WhatsApp</a>, or
        <a href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>

      <p class="small">
        Related: <a href="/legal/terms-and-conditions/">website terms and conditions</a> ·
        <a href="/legal/privacy-policy/">privacy policy</a> ·
        <a href="/how-to-order/">how to order</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .small {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }
  th[scope='row'] {
    white-space: nowrap;
  }
</style>
