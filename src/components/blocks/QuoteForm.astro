---
import { contact, formEndpoint } from '~/data/site';
import type { OrderRoute } from '~/data/tyres';
import type { TyreSizeGroup } from '~/data/sizes';

interface Props {
  id: string;
  /** "car" or "truck" — shapes the size picker and the container options. */
  kind: 'car' | 'truck';
  routes: readonly OrderRoute[];
  sizeGroups?: readonly TyreSizeGroup[];
  sizesFlat?: readonly string[];
}

const { id, kind, routes, sizeGroups, sizesFlat } = Astro.props;

/**
 * No backend is reconstructable from public information (CONTENT_TRUST_CONFLICTS R4).
 * Without a configured endpoint the form posts to a mailto: so it still works, and the phone
 * and WhatsApp routes are always present above it. See DEPLOYMENT.md to wire a real endpoint.
 */
const action = formEndpoint || `mailto:${contact.email}`;
const encType = formEndpoint ? 'application/x-www-form-urlencoded' : 'text/plain';
---

<form class="quote-form" id={id} method="post" action={action} enctype={encType} novalidate={false}>
  <input type="hidden" name="_subject" value={`Quote request — used ${kind} tyres`} />
  <input type="hidden" name="_source" value={Astro.url.pathname} />

  <div class="hp" aria-hidden="true">
    <label for={`${id}-company-url`}>Leave this field empty</label>
    <input
      id={`${id}-company-url`}
      type="text"
      name="company_url"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="quote-form__row">
    <div class="field">
      <label class="field__label" for={`${id}-name`}>
        Your name <span class="field__req" aria-hidden="true">*</span>
      </label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label class="field__label" for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="quote-form__row">
    <div class="field">
      <label class="field__label" for={`${id}-email`}>
        Email <span class="field__req" aria-hidden="true">*</span>
      </label>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        required
        inputmode="email"
        spellcheck="false"
      />
    </div>
    <div class="field">
      <label class="field__label" for={`${id}-phone`}>
        Phone or WhatsApp <span class="field__req" aria-hidden="true">*</span>
      </label>
      <input
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        inputmode="tel"
      />
      <span class="field__hint">Include your country code.</span>
    </div>
  </div>

  <div class="quote-form__row">
    <div class="field">
      <label class="field__label" for={`${id}-country`}>
        Destination country <span class="field__req" aria-hidden="true">*</span>
      </label>
      <input id={`${id}-country`} name="country" type="text" autocomplete="country-name" required />
    </div>
    <div class="field">
      <label class="field__label" for={`${id}-quantity`}>Order size</label>
      <select id={`${id}-quantity`} name="quantity">
        {
          routes.map((r) => (
            <option value={r.name}>
              {r.name} — {r.quantity}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  {
    kind === 'car' && (
      <div class="field">
        <label class="field__label" for={`${id}-grade`}>
          Quality grade
        </label>
        <select id={`${id}-grade`} name="grade">
          <option value="">Not sure — advise me</option>
          <option value="High quality">High quality (4–8 mm)</option>
          <option value="Medium quality">Medium quality (2.5–5 mm)</option>
          <option value="Low quality">Low quality (1–3 mm)</option>
        </select>
      </div>
    )
  }

  {
    sizeGroups && (
      <fieldset class="fieldset">
        <legend>Sizes you need</legend>
        <p class="field__hint">
          Tick every size you are interested in, or leave blank and describe them in your message.
        </p>
        {sizeGroups.map((g) => (
          <details class="size-picker">
            <summary>
              {g.rim}" rim <span class="size-picker__count">{g.sizes.length}</span>
            </summary>
            <div class="choice-grid">
              {g.sizes.map((s) => (
                <label class="choice">
                  <input type="checkbox" name="sizes" value={s} />
                  <span>{s}</span>
                </label>
              ))}
            </div>
          </details>
        ))}
      </fieldset>
    )
  }

  {
    sizesFlat && (
      <fieldset class="fieldset">
        <legend>Sizes you need</legend>
        <div class="choice-grid">
          {sizesFlat.map((s) => (
            <label class="choice">
              <input type="checkbox" name="sizes" value={s} />
              <span>{s}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <div class="field">
    <label class="field__label" for={`${id}-message`}>Your message</label>
    <textarea
      id={`${id}-message`}
      name="message"
      rows="5"
      placeholder="Quantities, grade, seasonal mix, delivery port, timing…"></textarea>
  </div>

  <div class="field">
    <label class="choice choice--inline">
      <input type="checkbox" name="urgent" value="yes" />
      <span>This request is urgent</span>
    </label>
  </div>

  <p class="quote-form__consent">
    By sending this form you agree to FlexTyres using your details to respond to your inquiry. See
    the <a href="/legal/privacy-policy/">privacy policy</a>.
  </p>

  <button class="btn btn--primary btn--block" type="submit">Send inquiry</button>

  {
    !formEndpoint && (
      <p class="quote-form__fallback">
        This form opens your email client. You can also email{' '}
        <a href={`mailto:${contact.email}`}>{contact.email}</a>, call{' '}
        <a href={`tel:${contact.phoneE164}`}>{contact.phoneDisplay}</a> or message us on{' '}
        <a href={contact.whatsappUrl} rel="noopener">
          WhatsApp
        </a>
        .
      </p>
    )
  }
</form>

<style>
  .quote-form {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: var(--s-5);
  }
  @media (min-width: 40em) {
    .quote-form {
      padding: var(--s-6);
    }
    .quote-form__row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-4);
    }
  }
  .choice--inline {
    justify-content: flex-start;
    border: 0;
    padding-inline: 0;
    font-size: var(--fs-sm);
    min-height: 44px;
  }
  .choice--inline:hover {
    background: transparent;
  }
  .size-picker {
    border: 1px solid var(--c-border);
    border-radius: var(--r-sm);
    margin-bottom: var(--s-2);
  }
  .size-picker > summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: var(--s-3);
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .size-picker__count {
    color: var(--c-text-muted);
    font-weight: 400;
    font-size: var(--fs-xs);
  }
  .size-picker[open] > summary {
    border-bottom: 1px solid var(--c-border);
  }
  .size-picker .choice-grid {
    padding: var(--s-3);
  }
  .quote-form__consent {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
    margin-bottom: var(--s-4);
  }
  .quote-form__fallback {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
    margin: var(--s-4) 0 0;
  }
</style>
