---
/**
 * Answer-first block. Renders the direct answer to the question the page exists to answer,
 * immediately below the H1, in crawlable HTML with no JavaScript.
 */
interface Props {
  label?: string;
}

const { label = 'In short' } = Astro.props;
---

<div class="answer">
  <p class="answer__label">{label}</p>
  <slot />
</div>

<style>
  .answer__label {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-green-800);
    margin: 0 0 var(--s-2);
  }
</style>
